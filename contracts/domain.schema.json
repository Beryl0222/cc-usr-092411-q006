{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "数字草书限量履约领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EDITION_REGISTERED",
        "SERIAL_HELD",
        "SERIAL_HOLD_EXPIRED",
        "SERIAL_RESERVATION_LINKED",
        "SERIAL_RESERVATION_RELEASED",
        "SERIAL_OWNERSHIP_REGISTERED",
        "PAYMENT_CONFIRMED",
        "PAYMENT_REVOKED",
        "IDENTITY_REVIEW_PASSED",
        "IDENTITY_REVIEW_REJECTED",
        "REGISTRATION_SUBMITTED",
        "REGISTRATION_ACCEPTED",
        "REGISTRATION_FAILED",
        "SHIPMENT_TASK_CREATED",
        "ADDRESS_CHANGE_REQUESTED",
        "ADDRESS_CHANGE_APPROVED",
        "ADDRESS_CHANGE_REJECTED",
        "PHYSICAL_DISPATCHED",
        "SHIPMENT_DELIVERED",
        "SHIPMENT_RETURNED",
        "ORDER_QUARANTINED",
        "ORDER_QUARANTINE_CLEARED",
        "ORDER_REMEDIED",
        "REMEDY_CASE_OPENED",
        "REMEDY_RESOLVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "edition",
        "serial_reservation",
        "purchase_order",
        "fulfillment_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
